# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Temporary: AGENTS.md rule 3 says no API keys in the app. Once the backend hands out
# short-lived tokens, these move there and only the token source changes.

# Speech-to-text — https://console.soniox.com
SONIOX_API_KEY=
# Data-residency region of the project the key belongs to: us | eu | jp | in.
# A key only works on its own region's endpoint, so this must match the key. Defaults to "in".
# Measured from India: "in" connects ~7x faster than "us" and finalises ~280ms sooner.
SONIOX_REGION=in
# Optional, defaults to stt-rt-v5
SONIOX_MODEL=

# Rewriting and Roman-script (Hinglish) output — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional, defaults to openai/gpt-oss-120b (benchmarked fastest + most accurate)
OPENROUTER_MODEL=
