{
  "name": "subxvoice",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @subx/desktop dev",
    "dev:web": "pnpm --filter @subx/web dev",
    "build": "turbo run build",
    "check": "biome check . && turbo run typecheck test",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3"
  }
}
